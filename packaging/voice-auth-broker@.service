[Unit]
Description=OMP credential broker for Voice
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
ExecStart=/usr/local/libexec/voice-omp auth-broker serve --bind=127.0.0.1:9444
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/.omp

[Install]
WantedBy=multi-user.target
