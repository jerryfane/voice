# Allow the voiced service (audio group) to send USB HID telephony off-hook
# reports to Anker PowerConf speakerphones. Audio capture otherwise streams
# digital silence even when ALSA reports the microphone as unmuted.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="291a", ATTRS{idProduct}=="3301", GROUP="audio", MODE="0660", TAG+="uaccess"
