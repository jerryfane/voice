[Unit]
Description=Voice persistent local agent
After=network-online.target sound.target voice-whisper.service
Wants=network-online.target voice-whisper.service

[Service]
Type=simple
User=voice-agent
Group=voice-agent
SupplementaryGroups=audio video
WorkingDirectory=/home/voice-agent/voice-workspace
ExecStart=/usr/local/bin/voice --config /etc/voice/config.json listen
Restart=on-failure
RestartSec=3
Environment=HOME=/home/voice-agent
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/voice/voice.env
# Timers and other mutable state live here; systemd creates it as the service
# user and Voice resolves $XDG_STATE_HOME/voice for its state files.
StateDirectory=voice
Environment=XDG_STATE_HOME=/var/lib
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/voice-agent /var/cache/voice

[Install]
WantedBy=multi-user.target
