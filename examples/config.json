{
  "input": {
    "device": "default",
    "command": [
      "arecord",
      "-D",
      "{device}",
      "-q",
      "-f",
      "S16_LE",
      "-r",
      "{rate}",
      "-c",
      "{channels}",
      "-t",
      "raw",
      "-"
    ],
    "sample_rate": 16000
  },
  "output": {
    "device": "default",
    "command": [
      "aplay",
      "-D",
      "{device}",
      "-q",
      "-"
    ]
  },
  "wake": {
    "phrases": [
      "hey voice"
    ],
    "fuzz": 0,
    "detector": "stt",
    "vad": {
      "threshold": 0,
      "min_speech": "250ms",
      "silence": "700ms",
      "max_utterance": "12s",
      "pre_roll": "300ms"
    }
  },
  "feedback": {
    "light": "auto",
    "sound": "chime",
    "volume": 0.35
  },
  "timers": {
    "enabled": true
  },
  "stt": {
    "name": "whisper.cpp",
    "command": [
      "whisper-cli",
      "-m",
      "{model}",
      "-f",
      "{file}",
      "--no-timestamps",
      "--no-prints",
      "-t",
      "3",
      "-l",
      "en"
    ],
    "model": "models/ggml-tiny.en.bin",
    "timeout": "30s"
  },
  "tts": {
    "name": "piper",
    "command": [
      "piper",
      "--model",
      "{model}",
      "--output_file",
      "-"
    ],
    "model": "models/en_US-amy-medium.onnx",
    "timeout": "30s"
  },
  "brain": {
    "mode": "agent",
    "command": [
      "voice-agent-run",
      "{prompt}"
    ],
    "timeout": "10m0s",
    "persona": "You are Voice, a concise personal agent. Complete the user's request with your tools, remember useful context across turns, and answer in one or two natural spoken sentences.",
    "rules": false
  },
  "lights": [],
  "tvs": []
}
