{
  "input": {
    "device": "default",
    "command": [
      "arecord",
      "-D",
      "{device}",
      "-q",
      "-f",
      "S16_LE",
      "-r",
      "{rate}",
      "-c",
      "{channels}",
      "-t",
      "raw",
      "-"
    ],
    "sample_rate": 16000
  },
  "output": {
    "device": "default",
    "command": [
      "aplay",
      "-D",
      "{device}",
      "-q",
      "-"
    ]
  },
  "wake": {
    "phrases": [
      "hey voice",
      "hey boys"
    ],
    "fuzz": 0.2,
    "detector": "sherpa",
    "sherpa": {
      "encoder": "/var/lib/voice/models/sherpa-kws/encoder.int8.onnx",
      "decoder": "/var/lib/voice/models/sherpa-kws/decoder.onnx",
      "joiner": "/var/lib/voice/models/sherpa-kws/joiner.int8.onnx",
      "tokens": "/var/lib/voice/models/sherpa-kws/tokens.txt",
      "keywords": "/var/lib/voice/models/sherpa-kws/keywords.txt",
      "num_threads": 1,
      "max_active_paths": 4,
      "keywords_score": 3,
      "keywords_threshold": 0.25
    },
    "vad": {
      "threshold": 0,
      "min_speech": "250ms",
      "silence": "700ms",
      "max_utterance": "6s",
      "pre_roll": "1.5s"
    }
  },
  "feedback": {
    "light": "auto",
    "sound": "chime",
    "volume": 0.35
  },
  "timers": {
    "enabled": true
  },
  "stt": {
    "name": "whisper.cpp",
    "command": [
      "whisper-cli",
      "-m",
      "{model}",
      "-f",
      "{file}",
      "--no-timestamps",
      "--no-prints",
      "-t",
      "3",
      "-l",
      "en"
    ],
    "model": "models/ggml-tiny.en.bin",
    "timeout": "30s",
    "resident": {
      "endpoint": "http://127.0.0.1:8178/inference",
      "timeout": "10s"
    },
    "openrouter": {
      "endpoint": "https://openrouter.ai/api/v1/audio/transcriptions",
      "model": "openai/whisper-large-v3-turbo",
      "api_key_env": "OPENROUTER_API_KEY",
      "timeout": "5s"
    }
  },
  "tts": {
    "name": "piper",
    "command": [
      "piper",
      "--model",
      "{model}",
      "--output_file",
      "-"
    ],
    "model": "models/en_US-amy-medium.onnx",
    "timeout": "30s"
  },
  "brain": {
    "mode": "agent",
    "command": [
      "voice-agent-run",
      "{prompt}"
    ],
    "timeout": "10m0s",
    "persona": "You are Voice, a concise personal agent. Complete the user request with your tools, remember useful context across turns, and answer in one or two natural spoken sentences.",
    "rules": true,
    "jev": {
      "endpoint": "https://openrouter.ai/api/alpha/decisions",
      "model": "typesafe/jev-1.13",
      "api_key_env": "OPENROUTER_API_KEY",
      "confidence": 0.85,
      "timeout": "2s"
    }
  },
  "lights": [],
  "tvs": []
}
